[Unit]
Description=LB AUTO FastAPI Application
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=lbauto
Group=lbauto
WorkingDirectory=/opt/lb-auto
EnvironmentFile=/etc/lb-auto/lb-auto.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/lb-auto/.venv/bin/uvicorn backend.main:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=30
KillSignal=SIGINT
UMask=0027

# Basic systemd hardening. The application still needs write access to its
# SQLite database and uploads directory under /opt/lb-auto.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/lb-auto

[Install]
WantedBy=multi-user.target
