# Generate a unique value with: openssl rand -hex 32
LB_AUTO_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Public URL routed by Cloudflare Tunnel.
APP_BASE_URL=https://app.example.com

# Rotate the previously shared Fonnte token before production.
FONNTE_ENABLED=true
FONNTE_TOKEN=REPLACE_WITH_NEW_FONNTE_TOKEN
